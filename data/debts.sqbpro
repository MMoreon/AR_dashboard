данных (уровень документов реализации)
CREATE TABLE IF NOT EXISTS customer_debts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    snapshot_date DATE NOT NULL,          -- Дата среза (например, 2026-07-08)
    organization TEXT NOT NULL,           -- Организация
    sales_dept TEXT NOT NULL,             -- Отдел продаж
    department TEXT NOT NULL,             -- Отдел (Дистрибьюция 1 / Комплектация)
    team TEXT,                            -- Команда
    manager TEXT,                         -- Менеджер
    client TEXT NOT NULL,                 -- Контрагент
    contract TEXT,                        -- Договор
    document TEXT,                        -- Расчетный/плановый документ
    creation_date DATE,                   -- Дата возникновения
    plan_payment_date DATE,               -- Дата планового погашения
    days_to_payment INTEGER,              -- Дней до планового погашения
    amount_realization REAL DEFAULT 0,    -- Сумма реализации
    debt_total REAL DEFAULT 0,            -- Долг клиента: Всего
    debt_overdue REAL DEFAULT 0,          -- Долг клиента: Просрочено
    days_overdue INTEGER DEFAULT 0,       -- Дней просрочки
    our_debt REAL DEFAULT 0               -- Наш долг
);

-- Индексы для быстрой фильтрации на дашборде
CREATE INDEX IF NOT EXISTS idx_snapshot_date ON customer_debts(snapshot_date);
CREATE INDEX IF NOT EXISTS idx_department ON customer_debts(department);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
